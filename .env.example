# Supabase / PostgreSQL Credentials (Optional for local mode)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Maps API Key (Leaflet / OpenStreetMap default, Mapbox/Google optional)
VITE_MAPS_API_KEY=demo_key

# Firebase Cloud Messaging
VITE_FCM_PROJECT_ID=neighborhood-hero-fcm

# App Environment
VITE_APP_ENV=development
